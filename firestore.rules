```text
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsDocument() {
      return signedIn() &&
             resource.data.userId == request.auth.uid;
    }

    function ownsNewDocument() {
      return signedIn() &&
             request.resource.data.userId == request.auth.uid;
    }

    // User profile
    match /users/{userId} {
      allow read, write: if ownsUser(userId);
    }

    // Habits
    match /habits/{habitId} {
      allow read: if ownsDocument();
      allow create: if ownsNewDocument();
      allow update: if ownsDocument() && ownsNewDocument();
      allow delete: if ownsDocument();
    }

    // Routine tasks
    match /routineTasks/{taskId} {
      allow read: if ownsDocument();
      allow create: if ownsNewDocument();
      allow update: if ownsDocument() && ownsNewDocument();
      allow delete: if ownsDocument();
    }

    // Goals
    match /goals/{goalId} {
      allow read: if ownsDocument();
      allow create: if ownsNewDocument();
      allow update: if ownsDocument() && ownsNewDocument();
      allow delete: if ownsDocument();
    }

    // Journals
    match /journals/{journalId} {
      allow read: if ownsDocument();
      allow create: if ownsNewDocument();
      allow update: if ownsDocument() && ownsNewDocument();
      allow delete: if ownsDocument();
    }

    // Pomodoro focus sessions
    match /focusSessions/{sessionId} {
      allow read: if ownsDocument();
      allow create: if ownsNewDocument();
      allow update: if ownsDocument() && ownsNewDocument();
      allow delete: if ownsDocument();
    }

    // Everything else is denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
```
